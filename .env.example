# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Appwrite — server-only. Never expose these with NEXT_PUBLIC_.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key
APPWRITE_DATABASE_ID=phour
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_PROJECTS=projects
APPWRITE_COLLECTION_TASKS=tasks
APPWRITE_COLLECTION_SUBTASKS=subtasks
APPWRITE_COLLECTION_TAGS=tags
APPWRITE_COLLECTION_CATEGORIES=categories
APPWRITE_COLLECTION_FOCUS_SESSIONS=focus_sessions
APPWRITE_COLLECTION_HABITS=habits
APPWRITE_COLLECTION_SETTINGS=settings
APPWRITE_COLLECTION_ACTIVITY_LOG=activity_log
