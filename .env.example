# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Appwrite Database & Storage — server-only. Never expose these with NEXT_PUBLIC_.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key
APPWRITE_DATABASE_ID=phour-db

APPWRITE_COLLECTION_USERS=users_collection_id
APPWRITE_COLLECTION_PROJECTS=projects_collection_id
APPWRITE_COLLECTION_TASKS=tasks_collection_id
APPWRITE_COLLECTION_SUBTASKS=subtasks_collection_id
APPWRITE_COLLECTION_TAGS=tags_collection_id
APPWRITE_COLLECTION_CATEGORIES=categories_collection_id
APPWRITE_COLLECTION_FOCUS_SESSIONS=focus_sessions_collection_id
APPWRITE_COLLECTION_HABITS=habits_collection_id
APPWRITE_COLLECTION_SETTINGS=settings_collection_id
APPWRITE_COLLECTION_ACTIVITY_LOG=activity_log_collection_id
APPWRITE_COLLECTION_FILES=files_collection_id

APPWRITE_BUCKET_FILES=files_bucket_id
